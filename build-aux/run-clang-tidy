#!/usr/bin/env zsh

builtin emulate -L zsh
setopt EXTENDED_GLOB
setopt PUSHD_SILENT
setopt ERR_EXIT
setopt ERR_RETURN
setopt NO_UNSET
setopt PIPE_FAIL
setopt NO_AUTO_PUSHD
setopt NO_PUSHD_IGNORE_DUPS
setopt FUNCTION_ARGZERO

## Enable for script debugging
# setopt WARN_CREATE_GLOBAL
# setopt WARN_NESTED_VAR
# setopt XTRACE

autoload -Uz is-at-least && if ! is-at-least 5.8; then
  print -u2 -PR "%F{1}${funcstack[1]##*/}:%f Running on Zsh version %B${ZSH_VERSION}%b, but Zsh %B5.2%b is the minimum supported version. Upgrade zsh to fix this issue."
  exit 1
fi

run_lint() {
  if (( ! ${+SCRIPT_HOME} )) typeset -g SCRIPT_HOME=${ZSH_ARGZERO:A:h}
  local project_root=${SCRIPT_HOME:A:h}

  typeset -g host_os=${${(L)$(uname -s)}//darwin/macos}
  local -i fail_on_error=0
  local -i check_only=0
  local -i verbosity=1
  local -r _version='1.0.0'

  fpath=("${SCRIPT_HOME}/.functions" ${fpath})
  autoload -Uz log_info log_error log_output set_loglevel log_status log_warning

  local -r _usage="
Usage: %B${functrace[1]%:*}%b <option> [SOURCE_FILES]

%BOptions%b:

%F{yellow} Linting options%f
 -----------------------------------------------------------------------------
  %B-c | --check%b                      Check only, no actual fixes

%F{yellow} Output options%f
 -----------------------------------------------------------------------------
  %B-v | --verbose%b                    Verbose (more detailed output)
  %B--fail-[never|error]                Fail script never/on linting issues - default: %B%F{green}never%f%b
  %B--debug%b                           Debug (very detailed and added output)

%F{yellow} General options%f
 -----------------------------------------------------------------------------
  %B-h | --help%b                       Print this usage help
  %B-V | --version%b                    Print script version information"

  local -a args
  while (( # )) {
    case ${1} {
      -c|--check) check_only=1; shift ;;
      -v|--verbose) (( verbosity += 1 )); shift ;;
      -h|--help) log_output ${_usage}; exit 0 ;;
      -V|--version) print -Pr "${_version}"; exit 0 ;;
      --debug) verbosity=3; shift ;;
      --fail-never)
        fail_on_error=0
        shift
        ;;
      --fail-error)
        fail_on_error=1
        shift
        ;;
      --fail-fast)
        fail_on_error=2
        shift
        ;;
      *)
        args+=($@)
        break
        ;;
    }
  }

  set -- ${(@)args}
  set_loglevel ${verbosity}

  # Find clang-tidy
  local clang_tidy=""
  if (( ${+commands[clang-tidy-19]} )) {
    clang_tidy=clang-tidy-19
  } elif (( ${+commands[clang-tidy]} )) {
    clang_tidy=clang-tidy
  } elif [[ -x /opt/homebrew/opt/llvm/bin/clang-tidy ]] {
    clang_tidy=/opt/homebrew/opt/llvm/bin/clang-tidy
  } elif [[ -x /usr/local/opt/llvm/bin/clang-tidy ]] {
    clang_tidy=/usr/local/opt/llvm/bin/clang-tidy
  } else {
    log_error "No viable clang-tidy version found"
    exit 2
  }

  # Get source files
  local -a source_files=(${@})
  if (( ! #source_files )) {
    source_files=(src/**/*.(c|cpp|h|hpp)(.N))
  }

  if (( ! #source_files )) {
    log_info "No source files found to lint"
    exit 0
  }

  # Create compile_commands.json if it doesn't exist
  local compile_commands="${project_root}/compile_commands.json"
  if [[ ! -f ${compile_commands} ]] {
    log_warning "compile_commands.json not found. Generating with CMake..."
    local build_dir="${project_root}/build_lint"
    mkdir -p ${build_dir}
    cd ${build_dir}
    # Use Unix Makefiles for linting (Xcode generator doesn't generate compile_commands.json)
    # Set _LINTING_MODE to skip platform-specific checks
    if ! cmake -G "Unix Makefiles" -DCMAKE_EXPORT_COMPILE_COMMANDS=ON -D_LINTING_MODE=ON ${project_root} 2>&1 | grep -v "Qt6 Test not found" | grep -v "Tests will be disabled" > /dev/null; then
      # Check if it actually succeeded (warnings about Qt6 Test are OK in linting mode)
      if [[ ! -f ${build_dir}/compile_commands.json ]] && [[ ! -f ${project_root}/compile_commands.json ]]; then
        log_error "Failed to generate compile_commands.json"
        cd ${project_root}
        exit 2
      fi
    fi
    if [[ -f ${build_dir}/compile_commands.json ]]; then
      cp ${build_dir}/compile_commands.json ${compile_commands}
      log_info "Generated compile_commands.json"
    elif [[ -f ${project_root}/compile_commands.json ]]; then
      log_info "Found compile_commands.json in project root"
    else
      log_error "compile_commands.json was not generated"
      cd ${project_root}
      exit 2
    fi
    cd ${project_root}
  }

  # Run clang-tidy
  local -a tidy_args=(
    -p ${project_root}
    --config-file=${project_root}/.clang-tidy
  )

  if (( check_only )) {
    tidy_args+=('--warnings-as-errors=*')
  }

  # Determine number of parallel jobs
  # On macOS, use performance cores only (pcores), otherwise use all cores
  local -i num_jobs=4
  if [[ ${host_os} == "macos" ]]; then
    # Try to get performance core count on macOS
    if command -v sysctl > /dev/null 2>&1; then
      # Try hw.perflevel0.logicalcpu (performance cores) first
      num_jobs=$(sysctl -n hw.perflevel0.logicalcpu 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null || echo 4)
    fi
  else
    # Linux/other: use all cores
    num_jobs=$(nproc 2>/dev/null || echo 4)
  fi
  if (( num_jobs < 1 )) num_jobs=4
  
  log_info "Linting ${#source_files} file(s) with ${num_jobs} parallel job(s)..."

  local -i num_failures=0
  local temp_base_dir="${project_root}/.tmp"
  mkdir -p ${temp_base_dir}
  # Clean up previous temp files from this script
  rm -rf ${temp_base_dir}/run-clang-tidy-*(N)
  local temp_dir=$(mktemp -d ${temp_base_dir}/run-clang-tidy-XXXXXX)
  local verbose_output="${temp_dir}/verbose.log"
  # Create verbose.log file before parallel jobs start (ensure it exists)
  touch ${verbose_output} || {
    log_error "Failed to create verbose output file: ${verbose_output}"
    return 2
  }
  # Don't auto-delete temp files - they may be referenced in error messages
  # Temp files in .tmp are cleaned up on next run

  # Function to lint a single file
  lint_file() {
    local file=${1}
    local file_id=${2}
    local output_file="${temp_dir}/${file_id}.out"
    local error_file="${temp_dir}/${file_id}.err"
    local failed_file="${temp_dir}/${file_id}.failed"
    
    # Redirect output to temp file
    local output=$(${clang_tidy} ${tidy_args} ${file} 2>&1)
    # Append to verbose log (file should exist, but handle gracefully)
    if [[ -f ${verbose_output} ]]; then
      echo ${output} >> ${verbose_output} 2>/dev/null || true
    fi
    echo ${output} > ${output_file}
    
    if (( ${#output} > 0 )); then
      echo ${output} > ${error_file}
      echo ${file} > ${failed_file}
    fi
  }

  # Process files in parallel using job control
  local -i i=0
  while (( i < ${#source_files} )); do
    local -a pids=()
    local -i j=0
    
    # Start up to num_jobs parallel processes
    while (( j < num_jobs && i < ${#source_files} )); do
      lint_file ${source_files[$(( i + 1 ))]} ${i} &
      pids+=($!)
      (( i += 1 ))
      (( j += 1 ))
    done
    
    # Wait for all jobs in this batch to complete
    for pid (${pids}) {
      wait ${pid}
    }
  done

  # Collect results and log file names (for CI visibility)
  local -a failed_files=()
  for failed_file (${temp_dir}/*.failed(.N)) {
    local file=$(cat ${failed_file})
    local file_id=${${failed_file:t}:r}
    local error_file="${temp_dir}/${file_id}.err"
    
    failed_files+=(${file})
    (( num_failures += 1 ))
    if [[ -f ${error_file} ]]; then
      # Always log which file failed (for CI visibility)
      log_error "${file} has linting issues"
      if (( fail_on_error == 2 )) {
        return 2
      }
    fi
  }

  # Show verbose output if there are issues
  if (( num_failures > 0 )) && [[ -f ${verbose_output} ]]; then
    local line_count=$(wc -l < ${verbose_output} 2>/dev/null || echo 0)
    if (( line_count > 0 && line_count <= 20 )); then
      # Show detailed output for small files
      log_error "Linting details:"
      cat ${verbose_output}
    elif (( line_count > 20 )); then
      # For large output, show path (file names already logged above)
      log_info "Detailed linting output (${line_count} lines): ${verbose_output}"
    fi
  fi

  if (( num_failures && fail_on_error == 1 )) {
    log_error "Found ${num_failures} file(s) with linting issues"
    log_info "Temp files with detailed output are available in: ${temp_dir}"
    return 2
  } elif (( num_failures )) {
    log_warning "Found ${num_failures} file(s) with linting issues"
    log_info "Temp files with detailed output are available in: ${temp_dir}"
  } else {
    log_info "All files passed linting checks"
    # Clean up temp files on success (they weren't needed)
    rm -rf ${temp_dir}
  }
}

run_lint ${@}
