#!/usr/bin/env zsh

builtin emulate -L zsh
setopt EXTENDED_GLOB
setopt PUSHD_SILENT
setopt ERR_EXIT
setopt ERR_RETURN
setopt NO_UNSET
setopt PIPE_FAIL
setopt NO_AUTO_PUSHD
setopt NO_PUSHD_IGNORE_DUPS
setopt FUNCTION_ARGZERO

## Enable for script debugging
# setopt WARN_CREATE_GLOBAL
# setopt WARN_NESTED_VAR
# setopt XTRACE

autoload -Uz is-at-least && if ! is-at-least 5.8; then
  print -u2 -PR "%F{1}${funcstack[1]##*/}:%f Running on Zsh version %B${ZSH_VERSION}%b, but Zsh %B5.2%b is the minimum supported version. Upgrade zsh to fix this issue."
  exit 1
fi

run_all_checks() {
  if (( ! ${+SCRIPT_HOME} )) typeset -g SCRIPT_HOME=${ZSH_ARGZERO:A:h}
  local project_root=${SCRIPT_HOME:A:h}

  typeset -g host_os=${${(L)$(uname -s)}//darwin/macos}
  local -i verbosity=1
  local -i skip_tests=0
  local -i skip_formatting=0
  local -i skip_linting=0
  local -i skip_cmake_formatting=0
  local -r _version='1.0.0'

  fpath=("${SCRIPT_HOME}/.functions" ${fpath})
  autoload -Uz log_info log_error log_output set_loglevel log_status log_warning log_group

  local -r _usage="
Usage: %B${functrace[1]%:*}%b <option>

%BOptions%b:

%F{yellow} Check options%f
 -----------------------------------------------------------------------------
  %B--skip-tests%b                    Skip running tests
  %B--skip-formatting%b               Skip code formatting checks
  %B--skip-linting%b                  Skip code linting checks
  %B--skip-cmake-formatting%b         Skip CMake formatting checks

%F{yellow} Output options%f
 -----------------------------------------------------------------------------
  %B-v | --verbose%b                  Verbose (more detailed output)
  %B--debug%b                         Debug (very detailed and added output)

%F{yellow} General options%f
 -----------------------------------------------------------------------------
  %B-h | --help%b                     Print this usage help
  %B-V | --version%b                  Print script version information"

  local -a args
  while (( # )) {
    case ${1} {
      --skip-tests) skip_tests=1; shift ;;
      --skip-formatting) skip_formatting=1; shift ;;
      --skip-linting) skip_linting=1; shift ;;
      --skip-cmake-formatting) skip_cmake_formatting=1; shift ;;
      -v|--verbose) (( verbosity += 1 )); shift ;;
      -h|--help) log_output ${_usage}; exit 0 ;;
      -V|--version) print -Pr "${_version}"; exit 0 ;;
      --debug) verbosity=3; shift ;;
      *)
        log_error "Unknown option: ${1}"
        log_output ${_usage}
        exit 2
        ;;
    }
  }

  set_loglevel ${verbosity}

  # Get project name from buildspec.json
  local project_name="obs-audio-sync"
  if [[ -f ${project_root}/buildspec.json ]]; then
    local buildspec_name=$(grep -o '"name"[[:space:]]*:[[:space:]]*"[^"]*"' ${project_root}/buildspec.json | head -1 | sed 's/.*"name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/')
    if [[ -n ${buildspec_name} ]]; then
      project_name=${buildspec_name}
    fi
  fi

  local -i num_failures=0
  local -i total_checks=0
  local temp_dir=$(mktemp -d)
  # Don't auto-delete temp files - they may be referenced in error messages
  # Temp files in /tmp are cleaned up by the OS periodically

  log_group "Running all pre-commit checks"

  # 1. Code Formatting (Fix Mode)
  if (( ! skip_formatting )) {
    (( total_checks += 1 ))
    log_info "Running clang-format..."
    if ! "${SCRIPT_HOME}/run-clang-format" --fail-error; then
      log_error "clang-format failed"
      num_failures=$(( num_failures + 1 ))
    else
      log_status "clang-format completed"
    fi
  } else {
    log_info "Skipping clang-format"
  }

  # 2. CMake Formatting (Fix Mode)
  if (( ! skip_cmake_formatting )) {
    (( total_checks += 1 ))
    log_info "Running gersemi..."
    if ! "${SCRIPT_HOME}/run-gersemi" --fail-error; then
      log_error "gersemi failed"
      num_failures=$(( num_failures + 1 ))
    else
      log_status "gersemi completed"
    fi
  } else {
    log_info "Skipping gersemi"
  }

  # 3. Code Linting
  if (( ! skip_linting )) {
    (( total_checks += 1 ))
    log_info "Running clang-tidy..."
    if ! "${SCRIPT_HOME}/run-clang-tidy" --fail-error; then
      log_error "clang-tidy failed"
      num_failures=$(( num_failures + 1 ))
    else
      log_status "clang-tidy completed"
    fi
  } else {
    log_info "Skipping clang-tidy"
  }

  # 4. Tests
  if (( ! skip_tests )) {
    (( total_checks += 1 ))
    log_info "Running tests..."

    # Determine build directory based on platform
    local build_dir=""
    case ${host_os} {
      macos)
        build_dir="${project_root}/build_macos"
        ;;
      linux)
        build_dir="${project_root}/build_x86_64"
        ;;
      windows)
        build_dir="${project_root}/build_x64"
        ;;
      *)
        log_warning "Unknown platform ${host_os}, trying common build directories..."
        for dir in "${project_root}/build_macos" "${project_root}/build_x86_64" "${project_root}/build_x64" "${project_root}/build"; do
          if [[ -d ${dir} ]]; then
            build_dir=${dir}
            break
          fi
        done
        ;;
    }

    # Configure build if build directory doesn't exist
    if [[ -z ${build_dir} ]] || [[ ! -d ${build_dir} ]]; then
      log_info "Build directory not found. Configuring build..."
      build_dir="${project_root}/build_macos"
      case ${host_os} {
        macos)
          build_dir="${project_root}/build_macos"
          ;;
        linux)
          build_dir="${project_root}/build_x86_64"
          ;;
        windows)
          build_dir="${project_root}/build_x64"
          ;;
      }
      mkdir -p ${build_dir}
      cd ${build_dir}
      log_info "Running cmake --preset ${host_os}..."
      local cmake_config_output="${temp_dir}/cmake-config.log"
      if ! cmake --preset ${host_os} > ${cmake_config_output} 2>&1; then
        log_error "cmake configuration failed"
        local line_count=$(wc -l < ${cmake_config_output} 2>/dev/null || echo 0)
        if (( line_count > 0 && line_count <= 20 )); then
          cat ${cmake_config_output}
        elif (( line_count > 20 )); then
          log_error "Full output (${line_count} lines): ${cmake_config_output}"
        fi
        cd ${project_root}
        num_failures=$(( num_failures + 1 ))
      else
        log_status "cmake configuration completed"
        cd ${project_root}
      fi
    fi
    
    # Always build the full project first
    if [[ -d ${build_dir} ]]; then
      log_info "Running cmake --build..."
      cd ${build_dir}
      local cmake_build_output="${temp_dir}/cmake-build.log"
      if ! cmake --build ${build_dir} > ${cmake_build_output} 2>&1; then
        log_error "cmake build failed"
        local line_count=$(wc -l < ${cmake_build_output} 2>/dev/null || echo 0)
        if (( line_count > 0 && line_count <= 20 )); then
          cat ${cmake_build_output}
        elif (( line_count > 20 )); then
          log_error "Full output (${line_count} lines): ${cmake_build_output}"
        fi
        cd ${project_root}
        num_failures=$(( num_failures + 1 ))
      else
        log_status "cmake build completed"
        cd ${project_root}
      fi
    else
      log_error "Build directory not found after configuration attempt."
      num_failures=$(( num_failures + 1 ))
    fi
    
    # Always build tests before running them
    if [[ -d ${build_dir} ]] && (( num_failures == 0 )); then
      log_info "Running cmake --build --target ${project_name}-tests..."
      cd ${build_dir}
      local cmake_test_build_output="${temp_dir}/cmake-test-build.log"
      if ! cmake --build ${build_dir} --target ${project_name}-tests > ${cmake_test_build_output} 2>&1; then
        log_error "Failed to build tests. Tests may not be enabled."
        log_info "To enable tests, ensure Qt6 Test is available."
        local line_count=$(wc -l < ${cmake_test_build_output} 2>/dev/null || echo 0)
        if (( line_count > 0 && line_count <= 20 )); then
          cat ${cmake_test_build_output}
        elif (( line_count > 20 )); then
          log_info "Build output (${line_count} lines): ${cmake_test_build_output}"
        fi
        cd ${project_root}
        num_failures=$(( num_failures + 1 ))
      else
        log_status "Test build completed"
        cd ${project_root}
      fi
    fi
    
    # Now run tests
    if [[ -d ${build_dir} ]] && (( num_failures == 0 )); then
      log_info "Running tests from ${build_dir}..."
      cd ${build_dir}
      
      # Try to run tests with ctest
      if command -v ctest > /dev/null 2>&1; then
        # Check if any tests are registered
        local test_list_output="${temp_dir}/ctest-list.log"
        ctest -N > ${test_list_output} 2>&1
        local test_output=$(cat ${test_list_output})
        # Check for "No tests were found" message
        if echo ${test_output} | grep -q "No tests were found"; then
          log_error "No tests found in build directory. Tests may not be enabled."
          log_info "To enable tests, ensure Qt6 Test is available and rebuild the project."
          num_failures=$(( num_failures + 1 ))
        else
          # Count test lines
          local test_count=$(echo ${test_output} | grep -c "Test #" 2>/dev/null)
          if (( test_count == 0 )); then
            log_error "No tests found in build directory. Tests may not be enabled."
            log_info "To enable tests, ensure Qt6 Test is available."
            num_failures=$(( num_failures + 1 ))
          else
            log_info "Running ctest (${test_count} test(s))..."
            local ctest_output="${temp_dir}/ctest.log"
            if ctest --output-on-failure > ${ctest_output} 2>&1; then
              log_status "ctest passed"
              # Show summary if output is small
              local line_count=$(wc -l < ${ctest_output} 2>/dev/null || echo 0)
              if (( line_count > 0 && line_count <= 20 )); then
                cat ${ctest_output}
              fi
            else
              log_error "ctest failed"
              local line_count=$(wc -l < ${ctest_output} 2>/dev/null || echo 0)
              if (( line_count > 0 && line_count <= 20 )); then
                cat ${ctest_output}
              elif (( line_count > 20 )); then
                log_error "Full output (${line_count} lines): ${ctest_output}"
              fi
              num_failures=$(( num_failures + 1 ))
            fi
          fi
        fi
      else
        log_warning "ctest not found. Trying to run test executable directly..."
        
        # Try common test executable names
        local -a test_names=(
          "${project_name}-tests"
          "obs-audio-sync-tests"
          "plugintemplate-for-obs-tests"
        )
        
        local test_executable=""
        for name in ${test_names}; do
          # Check in various build config directories
          for config_dir in "RelWithDebInfo" "Debug" "Release" ""; do
            local test_path="${build_dir}"
            if [[ -n ${config_dir} ]]; then
              test_path="${build_dir}/${config_dir}"
            fi
            if [[ -f ${test_path}/${name} ]] || [[ -f ${test_path}/${name}.exe ]]; then
              test_executable="${test_path}/${name}"
              break
            fi
          done
          if [[ -n ${test_executable} ]]; then
            break
          fi
        done
        
        if [[ -n ${test_executable} ]]; then
          log_info "Running ${test_executable}..."
          local test_exec_output="${temp_dir}/test-exec.log"
          if ${test_executable} > ${test_exec_output} 2>&1; then
            log_status "Tests passed"
            local line_count=$(wc -l < ${test_exec_output} 2>/dev/null || echo 0)
            if (( line_count > 0 && line_count <= 20 )); then
              cat ${test_exec_output}
            fi
          else
            log_error "Tests failed"
            local line_count=$(wc -l < ${test_exec_output} 2>/dev/null || echo 0)
            if (( line_count > 0 && line_count <= 20 )); then
              cat ${test_exec_output}
            elif (( line_count > 20 )); then
              log_error "Full output (${line_count} lines): ${test_exec_output}"
            fi
            num_failures=$(( num_failures + 1 ))
          fi
        else
          log_error "Test executable not found after building. Tests may not be enabled."
          log_info "To enable tests, ensure Qt6 Test is available."
          num_failures=$(( num_failures + 1 ))
        fi
      fi
      cd ${project_root}
    fi
  } else {
    log_info "Skipping tests"
  }

  log_group "Check Summary"

  if (( num_failures > 0 )); then
    log_error "Failed ${num_failures} out of ${total_checks} check(s)"
    log_error "Please fix the issues above before committing"
    log_info "Temp files with detailed output are available in: ${temp_dir}"
    exit 2
  else
    log_status "All ${total_checks} check(s) passed!"
    # Clean up temp files on success (they weren't needed)
    rm -rf ${temp_dir}
    exit 0
  fi
}

run_all_checks ${@}
